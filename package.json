{
  "name": "clinic-appointment-booking.",
  "version": "1.0.0",
  "description": "The Clinic Appointment Booking System is a web application that lets patients view doctors, check available time slots and book appointments online.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "api": "json-server --watch db.json --port 3000",
    "start": "python3 -m http.server 5500",
    "test:coverage": "vitest run --coverage",
    "start:api": "json-server --host 0.0.0.0 --port ${PORT:-3000} db.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brovincemangwana/clinic-appointment-booking..git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/brovincemangwana/clinic-appointment-booking./issues"
  },
  "homepage": "https://github.com/brovincemangwana/clinic-appointment-booking.#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "json-server": "^0.17.4",
    "vitest": "^2.1.9"
  }
}
